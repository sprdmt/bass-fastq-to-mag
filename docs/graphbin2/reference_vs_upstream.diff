+try:
+    from cogent3.parse.fasta import MinimalFastaParser
+except ImportError:  # minimal equivalent for environments without cogent3
+
+    def MinimalFastaParser(path):
+        label, chunks = None, []
+        with open(path) as fh:
+            for line in fh:
+                line = line.strip()
+                if not line:
+                    continue
+                if line.startswith(">"):
+                    if label is not None:
+                        yield label, "".join(chunks)
+                    label, chunks = line[1:].strip(), []
+                else:
+                    chunks.append(line)
+        if label is not None:
+            yield label, "".join(chunks)
+
