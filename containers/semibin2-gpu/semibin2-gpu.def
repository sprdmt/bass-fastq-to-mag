# Apptainer equivalent of containers/semibin2-gpu/Dockerfile (same base image, same pin file).
# Build from the repository root, e.g. on LiSC:
#   apptainer build --fakeroot bass-fastq-to-mag-semibin2-gpu_2.4.1.sif containers/semibin2-gpu/semibin2-gpu.def
Bootstrap: docker
From: ghcr.io/mamba-org/micromamba:2.9.0

%labels
    org.opencontainers.image.title bass-fastq-to-mag-semibin2-gpu
    org.opencontainers.image.description SemiBin2 2.4.1 with CUDA 12.9 PyTorch 2.8.0
    org.opencontainers.image.version 2.4.1
    org.opencontainers.image.source https://github.com/sprdmt/bass-fastq-to-mag
    org.opencontainers.image.base.name ghcr.io/mamba-org/micromamba:2.9.0

%files
    workflow/envs/semibin2-gpu.yaml /opt/env/semibin2-gpu.yaml
    workflow/envs/semibin2-gpu.linux-64.pin.txt /opt/env/semibin2-gpu.linux-64.pin.txt

%environment
    export PATH=/opt/conda/bin:$PATH
    export MAMBA_ROOT_PREFIX=/opt/conda
    export PYTHONNOUSERSITE=1

%post
    set -e
    export MAMBA_ROOT_PREFIX=/opt/conda
    export PATH=/opt/conda/bin:$PATH
    export CONDA_OVERRIDE_CUDA=12.9
    micromamba install -y -n base -f /opt/env/semibin2-gpu.linux-64.pin.txt
    micromamba clean --all --yes
    chmod -R a+rX /opt/conda /opt/env

%test
    export PATH=/opt/conda/bin:$PATH
    SemiBin2 --version && python -c "import torch; print(torch.__version__, torch.version.cuda)"
