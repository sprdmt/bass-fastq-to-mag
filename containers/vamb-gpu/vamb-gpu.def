# Apptainer equivalent of containers/vamb-gpu/Dockerfile (same base image, same pin file).
# Build from the repository root, e.g. on LiSC:
#   apptainer build --fakeroot bass-fastq-to-mag-vamb-gpu_5.0.4.sif containers/vamb-gpu/vamb-gpu.def
Bootstrap: docker
From: ghcr.io/mamba-org/micromamba:2.9.0

%labels
    org.opencontainers.image.title bass-fastq-to-mag-vamb-gpu
    org.opencontainers.image.description VAMB/TaxVamb 5.0.4 with CUDA 12.9 PyTorch 2.8.0, plus taxconverter 1.1.0 in a second env
    org.opencontainers.image.version 5.0.4
    org.opencontainers.image.source https://github.com/sprdmt/bass-fastq-to-mag
    org.opencontainers.image.base.name ghcr.io/mamba-org/micromamba:2.9.0

%files
    workflow/envs/vamb-gpu.yaml /opt/env/vamb-gpu.yaml
    workflow/envs/vamb-gpu.linux-64.pin.txt /opt/env/vamb-gpu.linux-64.pin.txt
    containers/vamb-gpu/taxconverter.conda.linux-64.pin.txt /opt/env/taxconverter.conda.linux-64.pin.txt
    containers/vamb-gpu/taxconverter-requirements.txt /opt/env/taxconverter-requirements.txt

%environment
    export PATH=/opt/conda/bin:$PATH
    export MAMBA_ROOT_PREFIX=/opt/conda
    export PYTHONNOUSERSITE=1

%post
    set -e
    export MAMBA_ROOT_PREFIX=/opt/conda
    export PATH=/opt/conda/bin:$PATH
    export CONDA_OVERRIDE_CUDA=12.9
    micromamba install -y -n base -f /opt/env/vamb-gpu.linux-64.pin.txt
    micromamba create -y -n taxconverter -f /opt/env/taxconverter.conda.linux-64.pin.txt
    /opt/conda/envs/taxconverter/bin/python -m pip install --no-deps --no-cache-dir --require-hashes -r /opt/env/taxconverter-requirements.txt
    ln -s /opt/conda/envs/taxconverter/bin/taxconverter /opt/conda/bin/taxconverter
    micromamba clean --all --yes
    chmod -R a+rX /opt/conda /opt/env

%test
    export PATH=/opt/conda/bin:$PATH
    vamb --version && python -c "import torch; print(torch.__version__, torch.version.cuda)" && taxconverter --help > /dev/null
